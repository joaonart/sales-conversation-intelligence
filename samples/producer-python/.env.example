# Copy to .env, fill in, and load it with:  set -a; source .env; set +a
# (never commit the .env or the key file)

# Where to publish (given by the platform team)
SCI_PROJECT=jnart-intelligence-513001
SCI_TOPIC=sci-dev-conversations

# The producer's service account key. Use ONE of the two:
#  - the JSON itself (for example read from AWS Secrets Manager into this variable at startup), or
#  - the path of the JSON file (for local tests only).
# SCI_PUBSUB_KEY_JSON={"type":"service_account", ...}
# SCI_PUBSUB_KEY_FILE=/secure/path/sci-dev-producer-key.json
