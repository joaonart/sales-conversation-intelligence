{
  "name": "sci-admin-console",
  "version": "0.50.9",
  "private": true,
  "description": "Admin console (Google Apps Script web app) for Sales Conversation Intelligence",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "push": "npm run build && clasp push",
    "deploy": "npm run build && clasp push && clasp deploy"
  },
  "devDependencies": {
    "@google/clasp": "^3.0.0",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/preact": "3.2.6",
    "@types/google-apps-script": "^1.0.83",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "preact": "10.29.8"
  }
}
